# Copy to .env and keep it out of git. Never put real secrets in this file.
# Public HTTPS origin reachable by both the MCP client and GitHub-hosted runners.
PUBLIC_URL=https://mcp.example.com

GITHUB_OWNER=fmdntracker
GITHUB_REPO=gha-mcp-host
GITHUB_REF=main
# Fine-grained PAT: Actions read/write on the runner repository.
GITHUB_PAT_DISPATCH=
# Must match the runner repository's BROKER_SECRET Actions secret.
BROKER_SECRET=
# Independent bearer token used by the MCP client (openssl rand -hex 32).
MCP_AUTH_TOKEN=

GHA_MCP_IMAGE=ghcr.io/fmdntracker/gha-mcp-host:latest
BIND_ADDRESS=127.0.0.1
BROKER_PORT=8787
# Additional accepted Host headers, comma-separated (optional, include port).
ALLOWED_HOSTS=

DEFAULT_TTL_MINUTES=60
MAX_TTL_MINUTES=330
MAX_ENV_CREATES_PER_HOUR=10
AGENT_WAIT_SECONDS=50
EXEC_WORKERS=4
UNREACHABLE_LIMIT_SECONDS=600
MAX_OUTPUT_BYTES=268435456
